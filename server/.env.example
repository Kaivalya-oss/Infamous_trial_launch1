DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
FRONTEND_URL=
PORT=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email Notifications (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# SMS Notifications (Twilio/MSG91)
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=
ADMIN_PHONE=

# Firebase Admin: verifies Google/phone sign-in tokens. Required (sign-in returns 503 without it). Public project id, not a secret.
FIREBASE_PROJECT_ID=

# Razorpay webhook (Dashboard > Settings > Webhooks): URL https://<backend>/api/webhooks/razorpay, events payment.captured + order.paid.
# This is the webhook's own secret, NOT RAZORPAY_KEY_SECRET. Without it the webhook endpoint answers 503 (the 5-minute poller still reconciles).
RAZORPAY_WEBHOOK_SECRET=

# Number of reverse proxies in front of the app (used for per-IP rate limiting). Default 1.
TRUST_PROXY_HOPS=

# Optional tuning: max admin upload size in bytes (default 52428800 = 50 MB)
UPLOAD_MAX_BYTES=
